plugin.tx_felogin_login {
    redirectPageLogin = {$femanager.pids.loginPage}
    redirectPageLoginError = {$femanager.pids.loginPage}
    redirectPageLogout = {$femanager.pids.loginPage}
    redirectDisable = 0

    # Validation errors without the internal error code (e.g. "1554971665: ...").
    view.partialRootPaths.20 = EXT:digas_fe_management/Resources/Private/Extensions/fe_login/Partials/

    settings {
        # Password rules for "forgot password", same as EXT:fe_change_pwd (passwordComplexity).
        # Patterns are taken from its ChangePasswordValidator.
        passwordValidators {
            # Replaces the core StringLengthValidator, whose message is not translatable here.
            20 >
            20 {
                className = TYPO3\CMS\Extbase\Validation\Validator\RegularExpressionValidator
                options {
                    regularExpression = /^.{8,}$/su
                    errorMessage = LLL:EXT:digas_fe_management/Resources/Private/Language/locallang.xlf:passwordPolicy.minLength
                }
            }
            30 {
                className = TYPO3\CMS\Extbase\Validation\Validator\RegularExpressionValidator
                options {
                    regularExpression = /[A-Z]/
                    errorMessage = LLL:EXT:digas_fe_management/Resources/Private/Language/locallang.xlf:passwordPolicy.capitalChar
                }
            }
            40 {
                className = TYPO3\CMS\Extbase\Validation\Validator\RegularExpressionValidator
                options {
                    regularExpression = /[a-z]/
                    errorMessage = LLL:EXT:digas_fe_management/Resources/Private/Language/locallang.xlf:passwordPolicy.lowerCaseChar
                }
            }
            50 {
                className = TYPO3\CMS\Extbase\Validation\Validator\RegularExpressionValidator
                options {
                    regularExpression = /[0-9]/
                    errorMessage = LLL:EXT:digas_fe_management/Resources/Private/Language/locallang.xlf:passwordPolicy.digit
                }
            }
            60 {
                className = TYPO3\CMS\Extbase\Validation\Validator\RegularExpressionValidator
                options {
                    regularExpression = /[^0-9a-z]/i
                    errorMessage = LLL:EXT:digas_fe_management/Resources/Private/Language/locallang.xlf:passwordPolicy.specialChar
                }
            }
        }
        # Used in the hint text above the form (change_password_message).
        newPasswordMinLength = 8

        # German date format for the "valid until" line in the recovery mail.
        dateFormat = d.m.Y H:i

        # Hours the recovery link stays valid. Same as the TYPO3 default.
        forgotLinkHashValidTime = 12

        # Use the custom DiGA.Sax password-recovery mail template (matches the other femanager mails).
        # The body texts are translated via extensionName "digas_fe_management"
        # (keys passwordRecovery.email.* in locallang.xlf / de.locallang.xlf).
        email {
            templateRootPaths {
                20 = EXT:digas_fe_management/Resources/Private/Extensions/fe_login/Templates/Email/
            }
            # Needed so the template can use <f:layout name="Email" />.
            layoutRootPaths {
                20 = EXT:digas_fe_management/Resources/Private/Layouts/
            }
        }
    }

    _LOCAL_LANG {
        de.username = Email-Adresse
        default.username = Email-Address
        # Hint matches the passwordValidators above. %s = settings.newPasswordMinLength
        de.change_password_message = Bitte geben Sie Ihr neues Passwort zweimal ein. Das Passwort muss mindestens %s Zeichen lang sein und einen Großbuchstaben, einen Kleinbuchstaben, eine Ziffer und ein Sonderzeichen enthalten.
        default.change_password_message = Please enter your new password twice. The password must be at least %s characters long and contain an uppercase letter, a lowercase letter, a digit and a special character.
    }
}

# change logout form labels if temp user
[usergroup('{$femanager.kitodoTempUserGroup}')]
    page.headerData.100100101 = TEXT
    page.headerData.100100101 {
        value (
            <style>
            .tx-felogin-pi1 dl.username {display:none;}
            .tx-felogin-pi1 .status-message{font-size:1rem;}
            </style>
        )
    }

    plugin.tx_felogin_login {
        _LOCAL_LANG {
            de {
                logout = Jetzt anmelden
                ll_status_message = Falls Sie bereits einen Login besitzen, können Sie sich hier anmelden:
            }
            default {
                logout = Login now
                ll_status_message = If you already have a login, you can register here:
            }
        }
    }
[end]
